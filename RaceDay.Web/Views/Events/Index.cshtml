@model List<RaceDay.Web.Models.EventViewModel>
@{
    ViewData["Title"] = "Events";
    int currentUserId = (int)ViewBag.CurrentUserId;
}

<div class="d-flex justify-content-between align-items-end mb-4 border-bottom pb-3 mt-4">
    <div>
        <h2 class="mb-1 fw-bold" style="color: #0f172a;">Upcoming Events</h2>
        <p class="text-muted mb-0">Browse and manage your races</p>
    </div>
    <div class="d-flex align-items-center gap-3">
        <span class="text-muted small">Signed in as <strong>@ViewBag.UserName</strong> <span class="badge bg-secondary ms-1">@ViewBag.Role</span></span>
        <form method="post" asp-controller="Auth" asp-action="Logout" style="display:inline;">
            <button type="submit" class="btn btn-outline-danger btn-sm">Logout</button>
        </form>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">@TempData["Error"]</div>
}

@if (ViewBag.Role == "Organiser")
{
    <a href="/Events/Create" class="btn btn-primary mb-4">+ Create New Event</a>
}

<div class="row g-4">
    @foreach (var ev in Model)
    {
        bool isOwner = (ViewBag.Role == "Organiser" && ev.OrganiserId == currentUserId);

        <div class="col-md-6 col-lg-4">
            <div class="card h-100">
                @if (!string.IsNullOrEmpty(ev.ImageUrl))
                {
                    <img src="https://localhost:7196@(ev.ImageUrl)" class="card-img-top" alt="Event Banner" style="height: 180px; object-fit: cover; border-top-left-radius: 12px; border-top-right-radius: 12px;">
                }
                else
                {
                    <div style="height: 180px; background: #e2e8f0; display: flex; align-items: center; justify-content: center; border-top-left-radius: 12px; border-top-right-radius: 12px;">
                        <span style="color: #94a3b8; font-weight: 700; letter-spacing: 3px; font-size: 0.9rem;">EVENT BANNER</span>
                    </div>
                }
                <div class="card-body d-flex flex-column p-4">
                    <h5 class="card-title">@ev.Title</h5>
                    <p class="card-text flex-grow-1 mb-4">@ev.Description</p>

                    <div class="pt-3 border-top" style="font-size: 0.9rem;">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Date</span>
                            <span class="fw-semibold">@ev.Date.ToString("dd MMM yyyy")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Location</span>
                            <span class="fw-semibold">@ev.Location</span>
                        </div>
                    </div>

                    @if (isOwner)
                    {
                        <div class="mt-4 d-flex gap-2">
                            <a href="/Events/Attendees/@ev.EventId" class="btn btn-info w-100 text-white mb-2">View Attendees</a>
                            <a href="/Events/Edit/@ev.EventId" class="btn btn-outline-secondary w-50">Edit</a>
                            <form method="post" asp-action="Delete" asp-route-id="@ev.EventId" class="w-50" onsubmit="return confirm('Delete?');">
                                <button type="submit" class="btn btn-danger w-100">Delete</button>
                            </form>
                        </div>
                        <form method="post" asp-action="UploadImage" asp-route-id="@ev.EventId" enctype="multipart/form-data" class="mt-2">
                            <div class="input-group input-group-sm">
                                <input type="file" name="file" class="form-control" required />
                                <button type="submit" class="btn btn-outline-primary">Upload Banner</button>
                            </div>
                        </form>
                    }
                    else if (ViewBag.Role == "Participant")
                    {
                        <div class="mt-4">
                            @if (ev.IsEnrolled)
                            {
                                <div class="d-flex gap-2">
                                    <button class="btn btn-success w-50" disabled style="opacity: 0.6;">Enrolled</button>
                                    <form method="post" asp-action="Cancel" asp-route-enrolmentId="@ev.EnrolmentId" class="w-50">
                                        <button type="submit" class="btn btn-danger w-100">Cancel</button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <form method="post" asp-action="Enrol" asp-route-eventId="@ev.EventId">
                                    <button type="submit" class="btn btn-success w-100">Enrol Now</button>
                                </form>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>