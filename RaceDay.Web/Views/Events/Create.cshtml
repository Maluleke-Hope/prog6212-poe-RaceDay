@{
    ViewData["Title"] = "Create Event";
}

<div class="container mt-5" style="max-width: 600px;">
    <h2 class="mb-4">Create New Event</h2>
    
    @if (ViewBag.Error != null) 
    { 
        <div class="alert alert-danger">@ViewBag.Error</div> 
    }
    
    <form method="post">
        <div class="mb-3">
            <label class="form-label">Title</label>
            <input type="text" name="title" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea name="description" class="form-control" required></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label">Date</label>
            <input type="date" id="eventDate" name="date" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Location</label>
            <input type="text" name="location" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Distance (km)</label>
            <input type="number" step="0.1" name="distance" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Event Type</label>
            <select name="eventType" class="form-control">
                <option value="Run">Run</option>
                <option value="Walk">Walk</option>
                <option value="Cycle">Cycle</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Create Event</button>
        <a href="/Events" class="btn btn-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <script>
        document.getElementById('eventDate').min = new Date().toISOString().split("T")[0];
    </script>
}